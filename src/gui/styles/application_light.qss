/* SAPÉ Design System - Application Stylesheet (Light Theme) */

/* ===== GLOBAL STYLES ===== */
* {
    font-family: "IBM Plex Sans", sans-serif;
}

/* ===== MAIN WINDOW ===== */
QMainWindow {
    background-color: #F4F6FA;
    color: #212832;
}

/* ===== CENTRAL WIDGET & LAYOUTS ===== */
QWidget {
    background-color: #F4F6FA;
    color: #212832;
}

/* ===== HEADER COMPONENT ===== */
#header {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E1E5EA;
    padding: 12px 16px;
}

#header QLabel {
    color: #212832;
    font-weight: bold;
}

#header QPushButton {
    background-color: transparent;
    border: none;
    color: #212832;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
}

#header QPushButton:hover {
    background-color: #F4F6FA;
}

#header QPushButton:pressed {
    background-color: #1C3FF0;
    color: #FFFFFF;
}

/* ===== SIDEBAR ===== */
#sidebar {
    background-color: #F4F6FA;
    border-right: 1px solid #E1E5EA;
    padding: 12px;
}

#sidebar QLabel {
    color: #4B5563;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

#sidebar QPushButton {
    background-color: transparent;
    border: none;
    color: #212832;
    padding: 10px 12px;
    text-align: left;
    border-radius: 4px;
    margin-bottom: 4px;
    font-size: 13px;
}

#sidebar QPushButton:hover {
    background-color: #E1E5EA;
}

#sidebar QPushButton:checked {
    background-color: #1C3FF0;
    color: #FFFFFF;
    font-weight: 500;
}

/* ===== PAGES/CONTENT AREA ===== */
#pagesWidget {
    background-color: #F4F6FA;
}

QStackedWidget {
    background-color: #F4F6FA;
}

/* ===== STATUS BAR ===== */
#statusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E1E5EA;
    padding: 12px 16px;
}

#statusBar QLabel {
    color: #212832;
    font-size: 12px;
}

#statusBar QPushButton {
    background-color: #1C3FF0;
    border: none;
    color: #FFFFFF;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: 500;
    font-size: 12px;
    min-height: 32px;
    min-width: 80px;
}

#statusBar QPushButton:hover {
    background-color: #122AD2;
}

#statusBar QPushButton:pressed {
    background-color: #0A1FA0;
}

#statusBar QPushButton:disabled {
    background-color: #D1D5DB;
    color: #4B5563;
}

/* ===== GENERAL BUTTONS ===== */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E1E5EA;
    color: #212832;
    padding: 6px 12px;
    border-radius: 4px;
    font-weight: 500;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #F9FAFB;
    border: 1px solid #D1D5DB;
}

QPushButton:pressed {
    background-color: #1C3FF0;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #F9FAFB;
    color: #9CA3AF;
    border: 1px solid #E1E5EA;
}

/* ===== LABELS ===== */
QLabel {
    color: #212832;
}

/* Primary text (titles) */
QLabel[class="title"] {
    font-size: 14px;
    font-weight: bold;
    color: #212832;
}

/* Secondary text */
QLabel[class="subtitle"] {
    font-size: 12px;
    color: #4B5563;
}

/* ===== LINE EDITS ===== */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #E1E5EA;
    color: #212832;
    padding: 6px 8px;
    border-radius: 4px;
    font-size: 12px;
}

QLineEdit:focus {
    border: 1px solid #1C3FF0;
    background-color: #F9FAFB;
}

QLineEdit::placeholder {
    color: #9CA3AF;
}

/* ===== TEXT EDITS ===== */
QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #E1E5EA;
    color: #212832;
    padding: 8px;
    border-radius: 4px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
}

QTextEdit:focus {
    border: 1px solid #1C3FF0;
}

/* ===== COMBO BOXES ===== */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #E1E5EA;
    color: #212832;
    padding: 6px 8px;
    border-radius: 4px;
    font-size: 12px;
}

QComboBox:focus {
    border: 1px solid #1C3FF0;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #212832;
    selection-background-color: #1C3FF0;
}

/* ===== TABLES ===== */
QTableWidget,
QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F9FAFB;
    gridline-color: #E1E5EA;
    color: #212832;
    border: 1px solid #E1E5EA;
    border-radius: 4px;
}

QTableWidget::item,
QTableView::item {
    padding: 4px;
    border: none;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #1C3FF0;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #F4F6FA;
    color: #212832;
    padding: 6px;
    border: none;
    border-right: 1px solid #E1E5EA;
    border-bottom: 1px solid #E1E5EA;
    font-weight: 500;
    font-size: 11px;
}

/* ===== SCROLL BARS ===== */
QScrollBar:vertical {
    background-color: #F4F6FA;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #D1D5DB;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9CA3AF;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: #F4F6FA;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #D1D5DB;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9CA3AF;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* ===== CHECKBOXES ===== */
QCheckBox {
    color: #212832;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
}

QCheckBox::indicator:unchecked {
    background-color: #FFFFFF;
    border: 1px solid #E1E5EA;
}

QCheckBox::indicator:unchecked:hover {
    border: 1px solid #1C3FF0;
}

QCheckBox::indicator:checked {
    background-color: #1C3FF0;
    border: 1px solid #1C3FF0;
}

/* ===== RADIO BUTTONS ===== */
QRadioButton {
    color: #212832;
    spacing: 6px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
}

QRadioButton::indicator:unchecked {
    background-color: #FFFFFF;
    border: 1px solid #E1E5EA;
}

QRadioButton::indicator:checked {
    background-color: #1C3FF0;
    border: 1px solid #1C3FF0;
}

/* ===== MENU BAR ===== */
QMenuBar {
    background-color: #FFFFFF;
    color: #212832;
    border-bottom: 1px solid #E1E5EA;
}

QMenuBar::item:selected {
    background-color: #F4F6FA;
}

QMenu {
    background-color: #FFFFFF;
    color: #212832;
    border: 1px solid #E1E5EA;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1C3FF0;
    color: #FFFFFF;
}

/* ===== DIALOGS ===== */
QDialog {
    background-color: #F4F6FA;
    color: #212832;
}

QFileDialog,
QColorDialog,
QFontDialog {
    background-color: #F4F6FA;
}

/* ===== TABS ===== */
QTabWidget {
    background-color: #F4F6FA;
}

QTabBar {
    background-color: #F4F6FA;
}

QTabBar::tab {
    background-color: #FFFFFF;
    color: #4B5563;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
}

QTabBar::tab:hover {
    color: #212832;
}

QTabBar::tab:selected {
    color: #1C3FF0;
    border-bottom: 2px solid #1C3FF0;
}

/* ===== SPINBOX ===== */
QSpinBox,
QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #E1E5EA;
    color: #212832;
    padding: 4px;
    border-radius: 4px;
    font-size: 12px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #1C3FF0;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background-color: #E1E5EA;
    border: none;
    width: 16px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #D1D5DB;
}

/* ===== SEPARATORS ===== */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #E1E5EA;
}

/* ===== TOOLTIPS ===== */
QToolTip {
    background-color: #FFFFFF;
    color: #212832;
    border: 1px solid #E1E5EA;
    border-radius: 4px;
    padding: 4px;
}
